# Laisse tout vide pour tourner en mode mock (aucune cle requise, comportement
# de decision simule mais le pipeline complet - gate + streaming + TTS -
# fonctionne reellement).

# Groq — gratuit en continu (pas de carte bancaire), rapide, ideal pour le
# gate. Sert aussi de secours gratuit pour les reponses si pas de cle
# Anthropic. Cree une cle sur console.groq.com.
GROQ_API_KEY=

# Zhipu / Z.ai — active le vrai gate GLM-5.3-Flash (payant, priorite plus
# basse que Groq pour le gate)
ZHIPU_API_KEY=

# Anthropic — active la vraie generation de reponse avec Claude Sonnet 5
# (priorite la plus haute pour les reponses, mode navigateur uniquement).
# Nouveau compte = ~5$ de credit d'essai gratuit, pas de carte bancaire,
# verification SMS.
ANTHROPIC_API_KEY=

# OpenAI — bascule automatiquement TOUT le pipeline vocal sur l'API Realtime
# (WebRTC) au lieu du navigateur : annulation d'echo native, transcription
# multilingue native (Whisper), interruption fiable. Remplace Groq/GLM/
# Anthropic/Whisper-via-Groq pour la partie voix (le gate texte utilise
# toujours Groq/GLM derriere). Payant, pas d'offre gratuite. Cree une cle
# sur platform.openai.com.
OPENAI_API_KEY=

# Deepgram — active la diarisation automatique ("Identify speakers" dans
# l'onglet Conversation, pipeline navigateur/legacy uniquement) : identifie
# qui parle sur tout l'enregistrement de la session en une fois. Sans cette
# cle, le tag de locuteur reste manuel (clic sur une ligne pour la nommer,
# ca marche toujours sans cle). Cree une cle sur console.deepgram.com.
DEEPGRAM_API_KEY=

PORT=8787

# Production hardening — leave both blank for local dev.
# CORS_ORIGIN: restrict the API to one front-end origin once deployed
# (wide open by default so local dev needs zero config).
CORS_ORIGIN=
# TRUST_PROXY: set to "true" only if this sits behind a reverse proxy /
# load balancer, so rate limiting keys on the real client IP.
TRUST_PROXY=

# White-labeling — leave blank to keep the default EF Education First
# persona (bob-prompt.md). Point this at server/personas/generic-example.md
# (or your own copy of it) to run this as a different agent/brand — no
# code changes needed, just restart the server.
PERSONA_FILE=
