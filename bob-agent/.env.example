# Front-end build-time config (Vite reads these at build time, not
# runtime — set them before running `npm run build`, or in your host's
# build environment settings). Leave everything blank for local dev.

# Only needed when the front-end and back-end are on different hosts (e.g.
# front-end on Netlify, back-end on Railway/Render) — set to the back-end's
# full URL, no trailing slash (e.g. https://bob-api.up.railway.app). Left
# blank, every API call is a relative /api/... path, which works when
# they share one origin, or via Vite's dev proxy locally.
VITE_API_BASE_URL=

# White-labeling — the agent's display name and header tagline. Leave
# blank to keep the defaults this app ships with ("Bob" / "EF language
# companion"). Change the persona itself via PERSONA_FILE in server/.env,
# and the brand colors via the CSS custom properties in src/App.css's
# :root — see README's "White-labeling" section.
VITE_AGENT_NAME=
VITE_TAGLINE=
